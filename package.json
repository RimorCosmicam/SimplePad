{
  "name": "simplepad",
  "version": "1.0.0",
  "description": "A configurable soundboard / pad-based audio app with Apple Liquid Glass design",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.node.json && electron .",
    "build": "tsc -p tsconfig.node.json && vite build",
    "build:electron": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "electron-liquid-glass": "^1.0.0",
    "electron-store": "^10.0.0",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unzipper": "^0.12.3",
    "wavesurfer.js": "^7.8.0",
    "ytdlp-nodejs": "^2.3.5",
    "zustand": "^5.0.0"
  }
}